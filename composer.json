{
    "name": "gimnasio-titan/fidelizacion",
    "type": "project",
    "description": "Sistema de fidelización de clientes para gimnasio: suscripciones, puntos, canjes, antigüedad y promociones.",
    "keywords": ["laravel", "gimnasio", "fidelizacion"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
